  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Streamlit primary button: the single cross-reference-blue action on a sheet; disabled with a lock until sign-off.",
      "html": "<button class=\"ds-btn-primary\">Run AI extraction</button> <button class=\"ds-btn-primary\" disabled>Download note (PDF)</button>",
      "css": ":host{--ink:#2B2F2A;--ground:#EEF2EC;--sheet:#FBFCFA;--rule:#CFD8CC;--tick:#2E7D32;--query:#C62828;--xref:#1E4E8C;--muted:#5B6458;font-family:'Public Sans',sans-serif;color:var(--ink);} .ds-btn-primary{background:var(--xref);color:#fff;border:1px solid var(--xref);border-radius:4px;padding:.45rem 1rem;font:600 15px 'Public Sans',sans-serif;cursor:pointer;transition:background .15s;} .ds-btn-primary:hover{background:#14417A;} .ds-btn-primary:focus-visible{outline:2px solid var(--xref);outline-offset:2px;} .ds-btn-primary:disabled{background:#E3E9E0;border-color:#CFD8CC;color:#5B6458;cursor:not-allowed;}"
    },
    {
      "name": "Shell Navigation",
      "kind": "nav",
      "refersTo": "shell-bar",
      "description": "Graphite top bar with the product mark and module links; current page on a shell-active plate.",
      "html": "<nav class=\"ds-shell\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 32 32\"><rect x=\"3\" y=\"3\" width=\"26\" height=\"26\" rx=\"4\" fill=\"none\" stroke=\"#C9D2C6\" stroke-width=\"2\"/><path d=\"M8 11h9M8 16h6M8 21h5\" stroke=\"#7C8779\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><path d=\"M15.5 18.5 19.2 22.2 26.5 12\" fill=\"none\" stroke=\"#8CC08A\" stroke-width=\"2.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><a href=\"#\">Overview</a><a href=\"#\" aria-current=\"page\">Note Generator</a><a href=\"#\">IPO Calendar</a><a href=\"#\">Subscription Tracker</a></nav>",
      "css": ":host{--ink:#2B2F2A;--ground:#EEF2EC;--sheet:#FBFCFA;--rule:#CFD8CC;--tick:#2E7D32;--query:#C62828;--xref:#1E4E8C;--muted:#5B6458;font-family:'Public Sans',sans-serif;color:var(--ink);} .ds-shell{display:flex;align-items:center;gap:.4rem;height:3.5rem;padding:0 1rem;background:var(--ink);} .ds-shell svg{margin-right:.8rem;} .ds-shell a{color:#C9D2C6;text-decoration:none;font-size:.9rem;padding:.3rem .55rem;border-radius:4px;} .ds-shell a:hover{color:#fff;} .ds-shell a[aria-current=page]{background:#3D4339;color:#fff;} .ds-shell a:focus-visible{outline:2px solid #86A7D5;outline-offset:2px;}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "",
      "description": "Standard Streamlit text input on the world theme: sage wash, hairline, blue focus.",
      "html": "<label class=\"ds-field\">Reviewed by<input class=\"ds-input\" placeholder=\"Your full name\"></label>",
      "css": ":host{--ink:#2B2F2A;--ground:#EEF2EC;--sheet:#FBFCFA;--rule:#CFD8CC;--tick:#2E7D32;--query:#C62828;--xref:#1E4E8C;--muted:#5B6458;font-family:'Public Sans',sans-serif;color:var(--ink);} .ds-field{display:flex;flex-direction:column;gap:.35rem;font-size:.9rem;} .ds-input{background:#E3E9E0;border:1px solid #CFD8CC;border-radius:4px;padding:.55rem .75rem;font:15px 'Public Sans',sans-serif;color:var(--ink);caret-color:var(--xref);} .ds-input:hover{border-color:#9AA796;} .ds-input:focus-visible{outline:2px solid var(--xref);outline-offset:2px;}"
    },
    {
      "name": "Sheet",
      "kind": "card",
      "refersTo": "sheet",
      "description": "Keyed container (st-key-sheet-*): near-white paper with a sage hairline and contact shadow, here holding a lead figure.",
      "html": "<section class=\"ds-sheet\"><h2>P/E at upper band</h2><div class=\"ds-big\">30.0x</div><p>Peer median 22.1x · computed in Python</p></section>",
      "css": ":host{--ink:#2B2F2A;--ground:#EEF2EC;--sheet:#FBFCFA;--rule:#CFD8CC;--tick:#2E7D32;--query:#C62828;--xref:#1E4E8C;--muted:#5B6458;font-family:'Public Sans',sans-serif;color:var(--ink);} .ds-sheet{background:var(--sheet);border:1px solid var(--rule);border-radius:8px;padding:1.25rem 1.5rem 1.4rem;box-shadow:0 1px 2px rgba(43,47,42,.05);} .ds-sheet h2{font-size:1.15rem;font-weight:700;margin:0 0 .1rem;letter-spacing:-.01em;} .ds-big{font-size:3rem;font-weight:700;line-height:1.05;font-variant-numeric:tabular-nums;} .ds-sheet p{margin:.2rem 0 0;color:var(--muted);font-size:.9rem;}"
    },
    {
      "name": "Working-Paper Header",
      "kind": "custom",
      "refersTo": "",
      "description": "Title and purpose left, mono reference block right, 2px graphite rule below.",
      "html": "<header class=\"ds-wp\"><div><h1>Aarna Sutra Foods Limited (Sample)</h1><p>Every figure is ticked to its RHP page before a reviewer signs off.</p></div><div class=\"ds-meta\">W/P REF N-B68E28<br>SOURCE RHP · 15 PP<br>INFORMATION ONLY · NOT A RECOMMENDATION</div></header>",
      "css": ":host{--ink:#2B2F2A;--ground:#EEF2EC;--sheet:#FBFCFA;--rule:#CFD8CC;--tick:#2E7D32;--query:#C62828;--xref:#1E4E8C;--muted:#5B6458;font-family:'Public Sans',sans-serif;color:var(--ink);} .ds-wp{display:flex;justify-content:space-between;align-items:flex-end;gap:1.5rem;flex-wrap:wrap;border-bottom:2px solid var(--ink);padding-bottom:.9rem;} .ds-wp h1{font-size:1.85rem;font-weight:700;line-height:1.15;letter-spacing:-.01em;margin:0;} .ds-wp p{margin:.3rem 0 0;color:var(--muted);font-size:.95rem;max-width:68ch;} .ds-meta{font:500 .78rem/1.75 'JetBrains Mono',monospace;color:var(--muted);text-align:right;letter-spacing:.02em;}"
    },
    {
      "name": "Pencil Marks",
      "kind": "chip",
      "refersTo": "query-mark",
      "description": "The signature: tick, re-reference, numbered query, cleared query, cross-reference.",
      "html": "<div class=\"ds-marks\"><span>820.40<svg width=\"15\" height=\"15\" viewBox=\"0 0 16 16\" aria-label=\"ticked to source\" role=\"img\"><path d=\"M2.4 8.9 6.1 12.4 13.8 3.3\" fill=\"none\" stroke=\"#2E7D32\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span>Elsewhere<svg width=\"15\" height=\"15\" viewBox=\"0 0 16 16\" aria-label=\"page re-referenced\" role=\"img\"><circle cx=\"8\" cy=\"8\" r=\"6.6\" fill=\"none\" stroke=\"#1E4E8C\" stroke-width=\"1.3\" stroke-dasharray=\"2.2 1.8\"/><path d=\"M4.8 8.3 7.1 10.5 11.4 5.6\" fill=\"none\" stroke=\"#1E4E8C\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span>118.80<span class=\"ds-q\">Q1</span></span><span class=\"ds-q ds-cleared\">Q1</span><span class=\"ds-xref\">RHP/106</span></div>",
      "css": ":host{--ink:#2B2F2A;--ground:#EEF2EC;--sheet:#FBFCFA;--rule:#CFD8CC;--tick:#2E7D32;--query:#C62828;--xref:#1E4E8C;--muted:#5B6458;font-family:'Public Sans',sans-serif;color:var(--ink);} .ds-marks{display:flex;gap:1.2rem;align-items:center;font-variant-numeric:tabular-nums;} .ds-marks svg{vertical-align:-2px;margin-left:.35rem;} .ds-q{display:inline-flex;align-items:center;font:600 .72rem/1 'JetBrains Mono',monospace;color:var(--query);border:1.5px solid var(--query);border-radius:4px;padding:.12rem .3rem;margin-left:.35rem;} .ds-q.ds-cleared{color:var(--tick);border-color:var(--tick);} .ds-xref{font:600 .8rem 'JetBrains Mono',monospace;color:var(--xref);text-decoration:underline;text-underline-offset:3px;}"
    },
    {
      "name": "Tally Strip",
      "kind": "custom",
      "refersTo": "tally-strip",
      "description": "Three counts with their marks; open queries turn red when non-zero.",
      "html": "<div class=\"ds-tally\"><div><span>Ticked to source</span><b>45<svg width=\"15\" height=\"15\" viewBox=\"0 0 16 16\" aria-label=\"ticked to source\" role=\"img\"><path d=\"M2.4 8.9 6.1 12.4 13.8 3.3\" fill=\"none\" stroke=\"#2E7D32\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></b></div><div><span>On another page</span><b>0<svg width=\"15\" height=\"15\" viewBox=\"0 0 16 16\" aria-label=\"page re-referenced\" role=\"img\"><circle cx=\"8\" cy=\"8\" r=\"6.6\" fill=\"none\" stroke=\"#1E4E8C\" stroke-width=\"1.3\" stroke-dasharray=\"2.2 1.8\"/><path d=\"M4.8 8.3 7.1 10.5 11.4 5.6\" fill=\"none\" stroke=\"#1E4E8C\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></b></div><div class=\"ds-red\"><span>Open queries</span><b>1</b></div></div>",
      "css": ":host{--ink:#2B2F2A;--ground:#EEF2EC;--sheet:#FBFCFA;--rule:#CFD8CC;--tick:#2E7D32;--query:#C62828;--xref:#1E4E8C;--muted:#5B6458;font-family:'Public Sans',sans-serif;color:var(--ink);} .ds-tally{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--rule);border-radius:6px;background:#fff;} .ds-tally>div{padding:.7rem 1rem;border-left:1px solid var(--rule);} .ds-tally>div:first-child{border-left:0;} .ds-tally span{display:block;font-size:.8rem;font-weight:600;color:var(--muted);} .ds-tally b{display:flex;align-items:center;gap:.45rem;font-size:1.7rem;font-weight:700;line-height:1.2;font-variant-numeric:tabular-nums;} .ds-red b{color:var(--query);}"
    },
    {
      "name": "Steps",
      "kind": "chip",
      "refersTo": "step",
      "description": "The note's sequence: done in green wash with a tick, current outlined in graphite, pending in sage wash.",
      "html": "<div class=\"ds-steps\"><span class=\"ds-done\">Source</span><span class=\"ds-done\">Sections</span><span class=\"ds-on\">Review</span><span>Sign-off</span></div>",
      "css": ":host{--ink:#2B2F2A;--ground:#EEF2EC;--sheet:#FBFCFA;--rule:#CFD8CC;--tick:#2E7D32;--query:#C62828;--xref:#1E4E8C;--muted:#5B6458;font-family:'Public Sans',sans-serif;color:var(--ink);} .ds-steps{display:flex;gap:.4rem;flex-wrap:wrap;} .ds-steps span{font-size:.82rem;font-weight:600;padding:.3rem .7rem;border-radius:4px;background:#E3E9E0;color:var(--muted);border:1.5px solid transparent;} .ds-steps .ds-done{background:#DDEBDD;color:#23602A;} .ds-steps .ds-on{background:#fff;color:var(--ink);border-color:var(--ink);}"
    },
    {
      "name": "Reviewer Sign-off",
      "kind": "card",
      "refersTo": "signoff-box",
      "description": "Dashed sign-off box (st-key-signoff) holding the reviewer name, query clearing and the locked export.",
      "html": "<section class=\"ds-signoff\"><h2>Reviewer sign-off</h2><label><input type=\"checkbox\"> Clear Q1: checked against the RHP</label><button disabled>Download note (PDF)</button></section>",
      "css": ":host{--ink:#2B2F2A;--ground:#EEF2EC;--sheet:#FBFCFA;--rule:#CFD8CC;--tick:#2E7D32;--query:#C62828;--xref:#1E4E8C;--muted:#5B6458;font-family:'Public Sans',sans-serif;color:var(--ink);} .ds-signoff{background:#fff;border:1.5px dashed #9AA796;border-radius:8px;padding:1rem 1.1rem;display:flex;flex-direction:column;gap:.7rem;} .ds-signoff h2{font-size:1.15rem;font-weight:700;margin:0;} .ds-signoff label{font-size:.9rem;} .ds-signoff button{background:#E3E9E0;color:#5B6458;border:1px solid #CFD8CC;border-radius:4px;padding:.45rem;font:600 15px 'Public Sans',sans-serif;}"
    },
    {
      "name": "Calendar Event Chips",
      "kind": "chip",
      "refersTo": "event-opens",
      "description": "Event chips from the world's own inks; the last day is outlined in graphite, never red.",
      "html": "<div class=\"ds-evs\"><span class=\"ds-ev ds-opens\">Opens</span><span class=\"ds-ev ds-last\">Last day</span><span class=\"ds-ev ds-allot\">Allotment</span><span class=\"ds-ev ds-refund\">Refund</span><span class=\"ds-ev ds-listing\">Listing</span></div>",
      "css": ":host{--ink:#2B2F2A;--ground:#EEF2EC;--sheet:#FBFCFA;--rule:#CFD8CC;--tick:#2E7D32;--query:#C62828;--xref:#1E4E8C;--muted:#5B6458;font-family:'Public Sans',sans-serif;color:var(--ink);} .ds-evs{display:flex;gap:.4rem;} .ds-ev{display:inline-block;border-radius:3px;padding:.1rem .3rem;font-size:.78rem;font-weight:500;color:var(--ink);line-height:1.3;} .ds-opens{background:#DDEBDD;} .ds-last{background:#fff;box-shadow:inset 0 0 0 1.5px var(--ink);} .ds-allot{background:#DCE5F2;} .ds-refund{background:#E3E9E0;} .ds-listing{background:var(--ink);color:#fff;}"
